{
  "manifest_version": 2,
  "id": "github.lbcheng1145.cost-report",
  "version": "1.1.1",
  "name": "开销统计",
  "description": "查询麦麦的 token 消耗和模型花费，卡片布局对齐 WebUI 统计页：统计概览（含环比与迷你柱状图）、Prompt 缓存、模型花费分布、Token 流向拆解、单位成本与效率。支持命令和 LLM 工具调用。",
  "author": {
    "name": "Lbcheng1145",
    "url": "https://github.com/Lbcheng1145"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Lbcheng1145/maibot-cost-report"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.4.0",
    "max_version": "2.22.99"
  },
  "capabilities": [
    "statistics.local.models",
    "send.text",
    "send.image",
    "render.html2png"
  ],
  "plugin_type": "data",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "background": "#3B82F6"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}
